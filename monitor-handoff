#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/monitor-handoff
selection_file=$state_dir/monitor
max_selection_bytes=256

usage() {
  printf 'Usage: %s <list|select|selected|status|toggle> [monitor]\n' "${0##*/}" >&2
  exit 2
}

all_monitors() {
  hyprctl monitors all -j
}

active_monitors() {
  hyprctl monitors -j
}

monitor_exists() {
  local monitor=$1
  all_monitors | jq -e --arg monitor "$monitor" 'any(.name == $monitor)' >/dev/null
}

monitor_is_active() {
  local monitor=$1
  active_monitors | jq -e --arg monitor "$monitor" 'any(.name == $monitor)' >/dev/null
}

active_monitor_count() {
  active_monitors | jq 'length'
}

require_monitor_name() {
  local monitor=${1:-}
  [[ -n $monitor ]] || {
    printf 'No monitor selected. Left-click the widget and choose one.\n' >&2
    exit 2
  }
  [[ $monitor =~ ^[A-Za-z0-9_.:-]+$ ]] || {
    printf 'Invalid monitor output name: %s\n' "$monitor" >&2
    exit 2
  }
}

read_selection() {
  python3 - "$selection_file" "$max_selection_bytes" <<'PY'
import os
import stat
import sys

path = sys.argv[1]
limit = int(sys.argv[2])
flags = os.O_RDONLY | os.O_NONBLOCK
flags |= getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)

try:
    fd = os.open(path, flags)
except (FileNotFoundError, OSError):
    raise SystemExit(0)

try:
    info = os.fstat(fd)
    if not stat.S_ISREG(info.st_mode) or info.st_size > limit:
        raise SystemExit(0)
    value = os.read(fd, limit + 1)
finally:
    os.close(fd)

if len(value) <= limit:
    sys.stdout.buffer.write(value.splitlines()[0] + b"\n" if value else b"")
PY
}

write_selection() {
  local monitor=$1
  python3 - "$state_dir" "$selection_file" "$monitor" <<'PY'
import os
import sys
import tempfile

directory, destination, monitor = sys.argv[1:]
os.makedirs(directory, mode=0o700, exist_ok=True)
fd, temporary = tempfile.mkstemp(prefix=".monitor.", dir=directory)
try:
    os.fchmod(fd, 0o600)
    with os.fdopen(fd, "wb") as stream:
        stream.write((monitor + "\n").encode())
        stream.flush()
        os.fsync(stream.fileno())
    os.replace(temporary, destination)
except BaseException:
    try:
        os.unlink(temporary)
    except FileNotFoundError:
        pass
    raise
PY
}

case "${1:-}" in
  list)
    all_monitors | jq '[.[] | {
      name,
      description,
      active: (.disabled != true and .width > 0 and .height > 0),
      focused
    }]'
    ;;
  select)
    monitor=${2:-}
    require_monitor_name "$monitor"
    write_selection "$monitor"
    ;;
  selected)
    selection=$(read_selection)
    printf '%s\n' "${selection:-${2:-}}"
    ;;
  status)
    monitor=${2:-}
    if [[ -z $monitor ]]; then
      printf '{"text":"󰍹","tooltip":"Left-click to choose a monitor"}\n'
    elif ! monitor_exists "$monitor"; then
      jq -cn --arg monitor "$monitor" '{text:"󰶐",tooltip:("Left-click to choose · Right-click to reconnect " + $monitor)}'
    elif monitor_is_active "$monitor"; then
      jq -cn --arg monitor "$monitor" '{text:"󰍹",class:"active",tooltip:("Left-click to choose · Right-click to hand off " + $monitor)}'
    else
      jq -cn --arg monitor "$monitor" '{text:"󰶐",tooltip:("Left-click to choose · Right-click to reconnect " + $monitor)}'
    fi
    ;;
  toggle)
    monitor=${2:-}
    require_monitor_name "$monitor"

    if monitor_is_active "$monitor"; then
      if (( $(active_monitor_count) <= 1 )); then
        printf 'Refusing to disable the last active monitor.\n' >&2
        exit 4
      fi
      hyprctl eval "hl.monitor({ output = \"$monitor\", disabled = true })"
    else
      # Runtime Lua monitor rules accumulate. Reloading clears the transient
      # disabled rule and restores the user's own monitors.lua configuration.
      # The selected output may be absent from `monitors all` after the display
      # switches to another input, so reconnect must not require detection.
      hyprctl reload
    fi
    ;;
  *)
    usage
    ;;
esac
